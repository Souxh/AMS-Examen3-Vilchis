@startuml

title Tienda Online EcoPaso - Casos de Uso

left to right direction
skinparam packageStyle rectangle

actor "Cliente" as Cliente

rectangle "Sistema EcoPaso" {
    usecase "Consultar catalogo\nde productos" as UC1
    usecase "Buscar productos" as UC2
    usecase "Filtrar productos\npor categoria" as UC3
    usecase "Consultar detalles\ndel producto" as UC4
    usecase "Consultar disponibilidad\nde zapatillas" as UC5
    usecase "Agregar producto\nal carrito" as UC6
    usecase "Modificar carrito" as UC7
    usecase "Realizar compra" as UC8
    usecase "Validar disponibilidad\ndel producto" as UC9
    usecase "Procesar pago" as UC10
    usecase "Registrar pedido" as UC11
    usecase "Consultar historial\nde pedidos" as UC12
}

Cliente --> UC1
Cliente --> UC2
Cliente --> UC3
Cliente --> UC4
Cliente --> UC5
Cliente --> UC6
Cliente --> UC7
Cliente --> UC8
Cliente --> UC12

UC6 .> UC9 : <<include>>
UC8 .> UC9 : <<include>>
UC8 .> UC10 : <<include>>
UC8 .> UC11 : <<include>>

@enduml

